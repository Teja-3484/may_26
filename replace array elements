from typing import List

class Solution:
    def arrayChange(self, nums: List[int], operations: List[List[int]]) -> List[int]:
        d = {}

        for i in range(len(nums)):
            d[nums[i]] = i

        for old, new in operations:
            index = d[old]
            nums[index] = new

            del d[old]
            d[new] = index

        return nums
